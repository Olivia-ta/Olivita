rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global safety net: deny all reads and writes by default
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isVerified() && request.auth.uid == userId;
    }

    function isValidUserProfile(data, userId) {
      return data.uid is string
        && data.uid == userId
        && isValidId(data.uid)
        && data.email is string
        && data.email.size() <= 320
        && data.displayName is string
        && data.displayName.size() >= 1
        && data.displayName.size() <= 80
        && data.mysticTitle is string
        && data.mysticTitle.size() <= 120
        && data.avatarUrl is string
        && data.avatarUrl.size() <= 120000
        && data.language in ['vi', 'en']
        && data.starDustBalance is int
        && data.starDustBalance >= 0
        && data.starDustBalance <= 10000000
        && data.checkInStreak is int
        && data.checkInStreak >= 0
        && data.checkInStreak <= 36500
        && data.lastCheckInDate is string
        && data.lastCheckInDate.size() <= 10
        && data.lastCheckInDate.matches('^([0-9]{4}-[0-9]{2}-[0-9]{2})?$')
        && data.totalCheckIns is int
        && data.totalCheckIns >= 0
        && data.totalCheckIns <= 36500
        && data.createdAt is timestamp
        && data.updatedAt is timestamp
        && (!('lastCheckInAt' in data) || data.lastCheckInAt is timestamp);
    }

    function isValidTransaction(data, txId, userId) {
      return data.id is string
        && data.id == txId
        && isValidId(data.id)
        && data.userId is string
        && data.userId == userId
        && data.userId == request.auth.uid
        && data.type in ['welcome_grant', 'daily_checkin', 'streak_bonus', 'tarot_reading']
        && data.amount is int
        && data.amount >= -500
        && data.amount <= 1500
        && data.amount != 0
        && data.balanceAfter is int
        && data.balanceAfter >= 0
        && data.balanceAfter <= 10000000
        && data.description is string
        && data.description.size() >= 1
        && data.description.size() <= 240
        && (!('relatedReadingId' in data) || (data.relatedReadingId is string && data.relatedReadingId.size() <= 128))
        && data.createdAt is timestamp;
    }

    function isValidReading(data, readingId, userId) {
      return data.id is string
        && data.id == readingId
        && isValidId(data.id)
        && data.userId is string
        && data.userId == userId
        && data.userId == request.auth.uid
        && data.areaId in ['single_spark', 'triad_alignment', 'astral_grimoire']
        && data.areaName is string
        && data.areaName.size() >= 1
        && data.areaName.size() <= 100
        && data.cost in [100, 300, 500]
        && data.cards is list
        && (
          (data.areaId == 'single_spark' && data.cost == 100 && data.cards.size() == 1)
          || (data.areaId == 'triad_alignment' && data.cost == 300 && data.cards.size() == 3)
          || (data.areaId == 'astral_grimoire' && data.cost == 500 && data.cards.size() == 5)
        )
        && data.cards[0] is map
        && data.question is string
        && data.question.size() >= 1
        && data.question.size() <= 500
        && data.language in ['vi', 'en']
        && data.interpretation is map
        && data.interpretation.keys().hasAll(['overview', 'synthesis', 'guidance', 'cardInsights'])
        && data.interpretation.overview is string
        && data.interpretation.overview.size() <= 5000
        && data.interpretation.synthesis is string
        && data.interpretation.synthesis.size() <= 8000
        && data.interpretation.guidance is string
        && data.interpretation.guidance.size() <= 5000
        && data.interpretation.cardInsights is list
        && data.interpretation.cardInsights.size() >= 1
        && data.interpretation.cardInsights.size() <= 5
        && data.createdAt is timestamp;
    }

    function isValidPlaylistTrack(data, trackId, userId) {
      return data.id is string
        && data.id == trackId
        && isValidId(data.id)
        && data.userId is string
        && data.userId == userId
        && data.userId == request.auth.uid
        && data.title is string
        && data.title.size() >= 1
        && data.title.size() <= 140
        && (!('artist' in data) || (data.artist is string && data.artist.size() <= 100))
        && data.youtubeId is string
        && data.youtubeId.size() == 11
        && data.youtubeId.matches('^[a-zA-Z0-9_\\-]{11}$')
        && data.category is string
        && data.category.size() >= 1
        && data.category.size() <= 60
        && data.createdAt is timestamp;
    }

    function isValidMusicPreferences(data, prefId, userId) {
      return data.id is string
        && data.id == prefId
        && prefId == 'music'
        && data.userId is string
        && data.userId == userId
        && data.userId == request.auth.uid
        && data.lastTrackId is string
        && data.lastTrackId.size() <= 128
        && data.lastPlaylist is string
        && data.lastPlaylist.size() <= 60
        && data.volume is int
        && data.volume >= 0
        && data.volume <= 100
        && data.muted is bool
        && data.repeatMode in ['off', 'all', 'one']
        && data.updatedAt is timestamp;
    }

    match /users/{userId} {
      allow get: if isValidId(userId) && isOwner(userId);
      allow list: if false;
      allow create: if isValidId(userId)
        && isOwner(userId)
        && incoming().keys().hasAll([
          'uid', 'email', 'displayName', 'mysticTitle', 'avatarUrl',
          'language', 'starDustBalance', 'checkInStreak', 'lastCheckInDate',
          'totalCheckIns', 'createdAt', 'updatedAt'
        ])
        && incoming().keys().hasOnly([
          'uid', 'email', 'displayName', 'mysticTitle', 'avatarUrl',
          'language', 'starDustBalance', 'checkInStreak', 'lastCheckInDate',
          'lastCheckInAt', 'totalCheckIns', 'createdAt', 'updatedAt'
        ])
        && isValidUserProfile(incoming(), userId)
        && incoming().starDustBalance == 500
        && incoming().checkInStreak == 0
        && incoming().lastCheckInDate == ''
        && incoming().totalCheckIns == 0
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isValidId(userId)
        && isOwner(userId)
        && isValidUserProfile(incoming(), userId)
        && incoming().uid == existing().uid
        && incoming().email == existing().email
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          // Action: Profile edit
          incoming().diff(existing()).affectedKeys().hasOnly([
            'displayName', 'mysticTitle', 'avatarUrl', 'language', 'updatedAt'
          ])
          ||
          // Action: Daily check-in (+500 base, +1000 bonus every 7th consecutive day)
          (
            incoming().diff(existing()).affectedKeys().hasOnly([
              'starDustBalance', 'checkInStreak', 'lastCheckInDate',
              'lastCheckInAt', 'totalCheckIns', 'updatedAt'
            ])
            && incoming().lastCheckInDate.size() == 10
            && incoming().lastCheckInDate > existing().lastCheckInDate
            && incoming().lastCheckInAt == request.time
            && (!('lastCheckInAt' in existing()) || request.time >= existing().lastCheckInAt + duration.value(12, 'h'))
            && incoming().totalCheckIns == existing().totalCheckIns + 1
            && (incoming().checkInStreak == existing().checkInStreak + 1 || incoming().checkInStreak == 1)
            && (
              (incoming().checkInStreak % 7 == 0 && incoming().starDustBalance == existing().starDustBalance + 1500)
              || (incoming().checkInStreak % 7 != 0 && incoming().starDustBalance == existing().starDustBalance + 500)
            )
          )
          ||
          // Action: Tarot reading Star Dust deduction
          (
            incoming().diff(existing()).affectedKeys().hasOnly(['starDustBalance', 'updatedAt'])
            && (
              incoming().starDustBalance == existing().starDustBalance - 100
              || incoming().starDustBalance == existing().starDustBalance - 300
              || incoming().starDustBalance == existing().starDustBalance - 500
            )
            && incoming().starDustBalance >= 0
          )
        );

      allow delete: if false;

      match /transactions/{transactionId} {
        allow get: if isValidId(userId) && isValidId(transactionId) && isOwner(userId);
        allow list: if isValidId(userId) && isOwner(userId) && resource.data.userId == request.auth.uid;
        allow create: if isValidId(userId)
          && isValidId(transactionId)
          && isOwner(userId)
          && incoming().keys().hasAll([
            'id', 'userId', 'type', 'amount', 'balanceAfter', 'description', 'createdAt'
          ])
          && incoming().keys().hasOnly([
            'id', 'userId', 'type', 'amount', 'balanceAfter', 'description', 'relatedReadingId', 'createdAt'
          ])
          && isValidTransaction(incoming(), transactionId, userId)
          && incoming().createdAt == request.time
          && existsAfter(/databases/$(database)/documents/users/$(userId))
          && getAfter(/databases/$(database)/documents/users/$(userId)).data.starDustBalance == incoming().balanceAfter;

        allow update, delete: if false;
      }

      match /readings/{readingId} {
        allow get: if isValidId(userId) && isValidId(readingId) && isOwner(userId);
        allow list: if isValidId(userId) && isOwner(userId) && resource.data.userId == request.auth.uid;
        allow create: if isValidId(userId)
          && isValidId(readingId)
          && isOwner(userId)
          && incoming().keys().hasAll([
            'id', 'userId', 'areaId', 'areaName', 'cost', 'question',
            'language', 'cards', 'interpretation', 'createdAt'
          ])
          && incoming().keys().hasOnly([
            'id', 'userId', 'areaId', 'areaName', 'cost', 'question',
            'language', 'cards', 'interpretation', 'createdAt'
          ])
          && isValidReading(incoming(), readingId, userId)
          && incoming().createdAt == request.time
          && existsAfter(/databases/$(database)/documents/users/$(userId));

        allow update: if false;
        allow delete: if isValidId(userId) && isValidId(readingId) && isOwner(userId);
      }

      match /playlists/{trackId} {
        allow get: if isValidId(userId) && isValidId(trackId) && isOwner(userId);
        allow list: if isValidId(userId) && isOwner(userId) && resource.data.userId == request.auth.uid;
        allow create: if isValidId(userId)
          && isValidId(trackId)
          && isOwner(userId)
          && incoming().keys().hasAll([
            'id', 'userId', 'title', 'youtubeId', 'category', 'createdAt'
          ])
          && incoming().keys().hasOnly([
            'id', 'userId', 'title', 'artist', 'youtubeId', 'category', 'createdAt'
          ])
          && isValidPlaylistTrack(incoming(), trackId, userId)
          && incoming().createdAt == request.time
          && existsAfter(/databases/$(database)/documents/users/$(userId));

        allow update: if isValidId(userId)
          && isValidId(trackId)
          && isOwner(userId)
          && isValidPlaylistTrack(incoming(), trackId, userId)
          && incoming().id == existing().id
          && incoming().userId == existing().userId
          && incoming().youtubeId == existing().youtubeId
          && incoming().createdAt == existing().createdAt
          && incoming().diff(existing()).affectedKeys().hasOnly(['title', 'artist', 'category']);

        allow delete: if isValidId(userId) && isValidId(trackId) && isOwner(userId);
      }

      match /preferences/{prefId} {
        allow get: if isValidId(userId) && isValidId(prefId) && prefId == 'music' && isOwner(userId);
        allow list: if false;
        allow create: if isValidId(userId)
          && isValidId(prefId)
          && isOwner(userId)
          && incoming().keys().hasAll([
            'id', 'userId', 'lastTrackId', 'lastPlaylist', 'volume', 'muted', 'repeatMode', 'updatedAt'
          ])
          && incoming().keys().hasOnly([
            'id', 'userId', 'lastTrackId', 'lastPlaylist', 'volume', 'muted', 'repeatMode', 'updatedAt'
          ])
          && isValidMusicPreferences(incoming(), prefId, userId)
          && incoming().updatedAt == request.time
          && existsAfter(/databases/$(database)/documents/users/$(userId));

        allow update: if isValidId(userId)
          && isValidId(prefId)
          && isOwner(userId)
          && isValidMusicPreferences(incoming(), prefId, userId)
          && incoming().id == existing().id
          && incoming().userId == existing().userId
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly([
            'lastTrackId', 'lastPlaylist', 'volume', 'muted', 'repeatMode', 'updatedAt'
          ]);

        allow delete: if false;
      }
    }
  }
}
